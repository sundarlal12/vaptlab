import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';
import path from 'path';
import fs from 'fs';

export default defineConfig(({ mode }) => ({
  plugins: [
    react({
      fastRefresh: mode !== 'production', // Disable React Refresh in production
    }),
    // Block sensitive paths early so Vite doesn't try to parse non-js files
    {
      name: 'block-sensitive-paths',
      configureServer(server) {
        server.middlewares.use((req, res, next) => {
          const url = req.url || '';
          // Normalize and simple checks
          // Block any request for .git metadata, /proc, environ, /etc, or obvious sensitive files
          if (
            url.startsWith('/.git') ||
            url.includes('/.git/') ||
            url.startsWith('/proc') ||
            url.includes('/proc/') ||
            url.includes('/etc/passwd') ||
            url.includes('/proc/self/environ') ||
            url.match(/(^|\/)\.env($|\/)/)
          ) {
            res.statusCode = 404;
            res.end('Not Found');
            return;
          }
          next();
        });
      },
    },
  ],
  resolve: {
    alias: {
      '@': path.resolve(__dirname, 'src'),
    },
  },
  server: {
    // set host true only if you intentionally want it reachable from network
    // If this is a production server, consider removing/setting host:false
    host: true,
    port: 3002,
    open: true,
    hmr: mode !== 'production', // Disable HMR in production
    fs: {
      // Restrict file system access to the project root (defensive)
      allow: [path.resolve(process.cwd())],
      // Deny navigating up out of the project root by default
    },
  },
  optimizeDeps: {
    // If some packages cause optimizer trouble, add them here.
    // Example: exclude: ['some-problematic-package']
    exclude: [],
  },
  build: {
    outDir: 'dist',
    minify: 'esbuild',
    sourcemap: false,
    rollupOptions: {
      input: 'index.html',
    },
  },
}));

